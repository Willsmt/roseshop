set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks não encontrado. Instale antes de commitar (ver docs/operacao.md)." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose || {
  echo "Commit bloqueado: possível segredo no stage (ver saída do gitleaks acima)." >&2
  exit 1
}

npx --no -- lint-staged
