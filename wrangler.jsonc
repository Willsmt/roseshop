/**
 * Ambientes (ADR-006):
 *   nível de cima  → LOCAL (npm run preview). Nome inofensivo: um deploy sem
 *                    --env nunca atinge dev nem produção.
 *   env.dev        → worker roseshop-dev  (deploy manual permitido)
 *   env.production → worker roseshop      (deploy SOMENTE pelo CI)
 *
 * Bindings NÃO são herdados entre ambientes: cada env redeclara os seus.
 * O nome do binding é o mesmo em todos os ambientes; só o recurso muda.
 * Nunca use "remote": true no nível de cima (o local não acessa recursos online).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "roseshop-local",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	"images": { "binding": "IMAGES" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop-local" }],
	"r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "roseshop-local" }],

	"env": {
		"dev": {
			"name": "roseshop-dev",
			"images": { "binding": "IMAGES" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop-dev" }],
			"r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "roseshop-dev" }]
		},
		"production": {
			"name": "roseshop",
			"images": { "binding": "IMAGES" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop" }],
			"r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "roseshop-prod" }]
		}
	}
}
