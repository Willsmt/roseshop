# Copie para .dev.vars (nunca commite o .dev.vars).
# Os valores abaixo são da stack LOCAL (docker-compose.yml) e não são segredos:
# banco local, preso em 127.0.0.1, só com dados de seed.

NEXTJS_ENV=development

# Banco local (Postgres 18 em Docker, porta 5440 no host).
# A mesma string serve ao driver (via proxy) e às migrations (conexão direta).
DATABASE_URL=postgres://roseshop:roseshop_local@localhost:5440/roseshop

# Proxy HTTP local do Neon. Defina SOMENTE no ambiente local;
# em dev online e produção, deixe ausente.
NEON_FETCH_ENDPOINT=http://localhost:4444/sql

# Auth.js com Google. Gere o AUTH_SECRET com: openssl rand -base64 32
# Cada ambiente (local, dev, produção) tem o SEU AUTH_SECRET.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mails autorizados no painel, separados por vírgula, sem espaço (allowlist).
ADMIN_EMAILS=

# OpenAI: chave do projeto roseshop-dev, com teto de gasto.
OPENAI_API_KEY=

# R2 pelo endpoint S3 local do wrangler (npm run preview). Valores FALSOS e fixos,
# iguais a local_dev.experimental_s3_credentials no wrangler.jsonc; não são segredo.
# Em dev e produção vêm de `wrangler secret put` (token do bucket do ambiente).
R2_ACCESS_KEY_ID=roseshop-local
R2_SECRET_ACCESS_KEY=roseshop-local-nao-secreto

# Protege a limpeza diária (SF12). Local: qualquer valor não vazio.
CRON_SECRET=local
