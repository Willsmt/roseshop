/**
 * Ambientes (ADR-006):
 *   nível de cima  → LOCAL (npm run preview). Nome inofensivo: um deploy sem
 *                    --env nunca atinge dev nem produção.
 *   env.dev        → worker roseshop-dev  (deploy manual permitido)
 *   env.production → worker roseshop      (deploy SOMENTE pelo CI)
 *
 * Bindings NÃO são herdados entre ambientes: cada env redeclara os seus.
 * O nome do binding é o mesmo em todos os ambientes; só o recurso muda.
 * Nunca use "remote": true no nível de cima (o local não acessa recursos online).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "roseshop-local",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	"images": { "binding": "IMAGES" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop-local" }],
	"r2_buckets": [
		{
			"binding": "PRODUCT_IMAGES",
			"bucket_name": "roseshop-local",
			// Endpoint S3 local do wrangler (ADR-009 D6). Credenciais FALSAS e fixas,
			// iguais às do .dev.vars.example; não são segredo.
			"local_dev": {
				"experimental_s3_credentials": {
					"accessKeyId": "roseshop-local",
					"secretAccessKey": "roseshop-local-nao-secreto"
				}
			}
		}
	],
	// vars não são herdadas: cada env redeclara. O endpoint inclui o bucket do ambiente.
	"vars": { "R2_S3_ENDPOINT": "http://localhost:8787/cdn-cgi/local/r2/s3/roseshop-local" },

	"env": {
		"dev": {
			"name": "roseshop-dev",
			"images": { "binding": "IMAGES" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop-dev" }],
			"r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "roseshop-dev" }],
			"vars": { "R2_S3_ENDPOINT": "https://e93918940385c0ea43d9327d98a78554.r2.cloudflarestorage.com/roseshop-dev" }
		},
		"production": {
			"name": "roseshop",
			"images": { "binding": "IMAGES" },
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "roseshop" }],
			"r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "roseshop-prod" }],
			"vars": { "R2_S3_ENDPOINT": "https://e93918940385c0ea43d9327d98a78554.r2.cloudflarestorage.com/roseshop-prod" }
		}
	}
}
